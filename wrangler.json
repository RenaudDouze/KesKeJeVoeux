{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keskejevoeux",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LIST_ROOM",
        "class_name": "ListRoom"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "IMAGE_WRITE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "LIST_LOOKUP_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 200, "period": 60 }
    },
    {
      "name": "LIST_CREATE_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  "r2_buckets": [
    {
      "binding": "ITEM_IMAGES",
      "bucket_name": "keskejevoeux-item-images"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ListRoom"]
    }
  ]
}
